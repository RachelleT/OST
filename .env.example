# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public base URL — used wherever absolute URLs are emitted (og tags, share images, sitemap).
# In .env.local, set this to your current Vercel-default URL (e.g. https://your-project.vercel.app).
# In Step 13 (domain switchover), this becomes https://dayspark.yuvoice.com
VITE_PUBLIC_BASE_URL=https://your-project.vercel.app

# Web Push (VAPID)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
